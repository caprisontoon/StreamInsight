# 웹 서버 포트
PORT=3000
# 로컬 SQLite 데이터베이스 파일 경로 (TURSO_DATABASE_URL 이 없을 때)
DB_PATH=data/streaminsight.db
# 원격 DB (Turso). Vercel 배포 시 필수
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# /api/cron/collect 호출용 비밀키 (외부 스케줄러에서 Authorization: Bearer <값> 으로 호출)
CRON_SECRET=
# 수집 주기(초). 소프트콘 뷰어십 등 유사 서비스와 같이 5분 간격 스냅샷이 기본값
COLLECT_INTERVAL_SEC=300
# 수집할 플랫폼 (쉼표 구분): chzzk, soop, twitch, youtube
PLATFORMS=chzzk,soop,twitch,youtube
# 이 시청자 수 미만의 방송은 수집하지 않음 (목록 페이지 순회 종료 기준)
MIN_VIEWERS=5
# 플랫폼별 라이브 목록 최대 페이지 수
MAX_PAGES=40
# 방송별 시청자 스냅샷 보관 기간(일). 일별 집계 데이터는 영구 보관
SNAPSHOT_RETENTION_DAYS=180
# 팔로워 수를 갱신할 상위 채널 수 (매 시간)
FOLLOWER_TOP_N=300
# 수집기 사용 여부 (false 면 웹 서버만 실행)
ENABLE_COLLECTOR=true

# 트위치는 공식 Helix API 키가 필요합니다: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 수집할 트위치 방송 언어
TWITCH_LANGUAGE=ko

# 유튜브는 YouTube Data API v3 키가 필요합니다: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# 꼭 추적할 채널 ID (UC로 시작, 쉼표 구분). RSS로 확인하므로 쿼터를 쓰지 않음
YOUTUBE_CHANNEL_IDS=
# 새 라이브 검색 주기(분)와 1회 검색 페이지 수 (페이지당 50개, 100 쿼터)
YOUTUBE_SEARCH_INTERVAL_MIN=60
YOUTUBE_SEARCH_PAGES=2
# 지정 채널 RSS 확인 주기(분)
YOUTUBE_RSS_INTERVAL_MIN=10
YOUTUBE_REGION=KR
YOUTUBE_LANGUAGE=ko
# 한국어 방송만 수집 (제목·채널명 한글 또는 언어 설정 ko)
YOUTUBE_KOREAN_ONLY=true
# 제외할 유튜브 카테고리 ID (25 = 뉴스/정치, 24시간 뉴스 라이브 제외용). 비우면 모두 수집
YOUTUBE_EXCLUDE_CATEGORIES=25
# 하루 쿼터와, 검색을 멈추고 추적용으로 남겨 둘 쿼터
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_RESERVE=2000
